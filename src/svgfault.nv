// svgfault.nv — what reading an SVG document can go wrong on.
//
// Every variant carries a byte offset into the string the caller handed
// over, so slicing around it shows what the reader was looking at.
//
// A fault means the input is not well-formed XML, or a number where a
// number has to be is not one.  An element or an attribute this package
// does not model is skipped rather than refused, and
// `svgread.parse_report` counts it.
//
// The writer reports one fault of its own: `SvgBadNumber` for a value
// that is not finite, which SVG has no spelling for.  Its offset is into
// the text the writer would have produced.
//
// No function here has an effect.

// What reading an SVG can go wrong on.
//
// ```novo
// use svgfault
//
// fn main() [io]
//     println("${svgfault.offset_of(SvgTruncated(0))}")
// ```
pub enum SvgFault
    // The document ended in the middle of something: an unclosed tag,
    // an unterminated attribute value, an unfinished entity.
    SvgTruncated(offset: Int)
    // A `<` that does not begin a tag this package can read, or a tag
    // whose name is not a name.
    SvgMalformedTag(offset: Int, found: Str)
    // A closing tag that does not match the open one.
    SvgMismatchedTag(offset: Int, opened: Str, closed: Str)
    // An attribute that is not `name="value"`.
    SvgMalformedAttribute(offset: Int, element: Str)
    // An attribute whose value has to be a number and is not.  The
    // writer reports a value that is not finite with this variant too.
    SvgBadNumber(offset: Int, attribute: Str, found: Str)
    // A `d` attribute that is not a path: an unknown command letter, a
    // command with the wrong number of arguments, an arc flag that is
    // neither 0 nor 1.
    SvgBadPathData(offset: Int, found: Str)
    // A `transform` attribute whose function is not one of SVG's six,
    // or has the wrong number of arguments.
    SvgBadTransform(offset: Int, found: Str)
    // A `viewBox` that is not four numbers.
    SvgBadViewBox(offset: Int, found: Str)
    // No `<svg>` element anywhere in the input.
    SvgNoRootElement(offset: Int)
    // An entity reference this package does not define.  The five XML
    // predefined entities and numeric character references are read;
    // a document that declares its own in a DOCTYPE is not.
    SvgUnknownEntity(offset: Int, name: Str)
    // The tree nests deeper than the reader's limit.  The limit keeps
    // a document built to nest without end from exhausting the stack.
    SvgTooDeep(offset: Int, limit: Int)

// The rule every `SvgFault` is printed by: say what was expected, quote
// what was found, and give the offset the reader can slice around.
//
// `Result<T, E>` requires `E: Error` (SPEC § 3.4), so this impl is what
// makes every fallible signature in the package spellable.
impl Error for SvgFault
    fn message(self) -> Str
        match self
            SvgTruncated(at)                     =>
                "the document ends inside an element, at byte ${at}"
            SvgMalformedTag(at, found)           =>
                "'${found}' at byte ${at} does not begin a tag"
            SvgMismatchedTag(at, opened, closed) =>
                "<${opened}> is closed by </${closed}> at byte ${at}"
            SvgMalformedAttribute(at, element)   =>
                "an attribute of <${element}> at byte ${at} is not name=\"value\""
            SvgBadNumber(at, attribute, found)   =>
                "${attribute}=\"${found}\" at byte ${at} is not a number"
            SvgBadPathData(at, found)            =>
                "'${found}' at byte ${at} is not a path command"
            SvgBadTransform(at, found)           =>
                "'${found}' at byte ${at} is not a transform function"
            SvgBadViewBox(at, found)             =>
                "viewBox=\"${found}\" at byte ${at} is not four numbers"
            SvgNoRootElement(at)                 =>
                "no <svg> element, looking from byte ${at}"
            SvgUnknownEntity(at, name)           =>
                "&${name}; at byte ${at} is not an entity this reader defines"
            SvgTooDeep(at, limit)                =>
                "the tree nests deeper than ${limit} at byte ${at}"

// Where in the input the fault was found.
//
// The one thing every variant has, pulled out so a caller can slice the
// input without matching on eleven variants to find the number.
//
// ```novo
// use svgfault
//
// fn main() [io]
//     println("${svgfault.offset_of(SvgNoRootElement(0))}")
// ```
pub fn offset_of(f: SvgFault) -> Int
    match f
        SvgTruncated(at)             => at
        SvgMalformedTag(at, _)       => at
        SvgMismatchedTag(at, _, _)   => at
        SvgMalformedAttribute(at, _) => at
        SvgBadNumber(at, _, _)       => at
        SvgBadPathData(at, _)        => at
        SvgBadTransform(at, _)       => at
        SvgBadViewBox(at, _)         => at
        SvgNoRootElement(at)         => at
        SvgUnknownEntity(at, _)      => at
        SvgTooDeep(at, _)            => at
