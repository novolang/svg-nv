// svgdoc.nv — the document: a tree of shapes, each with its geometry,
// its style and its transform.
//
// ONE NODE TYPE, NOT NINE.  Every SVG element that draws anything
// carries the same three things — an id, a transform and the
// presentation attributes — and differs only in the geometry.  So
// `SvgNode` is a struct that holds those three plus an `SvgShape`, and
// `SvgShape` is the enum that carries the numbers.  A variant per
// element with the style repeated in each would be nine near-identical
// payloads, a writer with nine branches doing the same attribute work,
// and a reader that has to remember to handle `transform` nine times.
//
// THE BRIDGE TYPES, and they are the one thing to understand before
// reading a signature here.  `SvgTransform` and `SvgViewBox` hold the
// same numbers as geometry-nv's `GeomXform` and `GeomRectF`, and they
// exist because those two are `@value` structs and a BOXED aggregate
// cannot have an unboxed field (SPEC §14.5) — a document tree is boxed
// by construction, since it nests.  So the tree carries the numbers and
// `to_xform` / `of_xform` / `to_rect` / `of_rect` convert at the edge,
// where the arithmetic starts.  The conversion is six field reads; what
// it buys is that geometry-nv owns the transform algebra and this
// package never reimplements it.
//
// THE SUBSET, stated plainly.  `svg`, `g`, `rect`, `circle`, `ellipse`,
// `line`, `polyline`, `polygon`, `path` and `text` — the elements
// plot-nv emits and the elements usvg keeps after it has resolved
// everything else.  Not here: gradients, patterns, masks, clip paths,
// filters, markers, `use`, `image`, `symbol`, `switch`, CSS and
// animation.  A `url(#id)` paint survives as a reference nobody
// resolves; everything else in that list is dropped by the reader and
// cannot be constructed.
//
// NO EFFECTS.  A document is a value, and building one touches nothing.

use geompoint
use geomrect
use geomxform
use svgstyle
use svgpath

// A transform as a document carries it: SVG's six numbers.
//
// The boxed counterpart of geometry-nv's `GeomXform`, for the reason in
// the header.  `to_xform` is how the arithmetic gets at it.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.no_transform().a}")
// ```
pub struct SvgTransform
    // Row 0, column 0.
    a: Float
    // Row 0, column 1.
    b: Float
    // Row 1, column 0.
    c: Float
    // Row 1, column 1.
    d: Float
    // The translation along x.
    e: Float
    // The translation along y.
    f: Float

// The user coordinate system a document's contents are drawn in.
//
// The boxed counterpart of a `GeomRectF`, and the field that makes an
// SVG resolution-independent: the viewport is `width` by `height` in
// real units, the contents are drawn in THIS rectangle, and the
// renderer scales between them.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.view_box(0.0, 0.0, 640.0, 480.0).width}")
// ```
pub struct SvgViewBox
    // The left edge of the user coordinate system.
    x: Float
    // The top edge.
    y: Float
    // How wide it is.  Zero or negative disables rendering entirely,
    // which is SVG's own rule rather than this package's.
    width: Float
    // How tall it is.
    height: Float

// What one element draws.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println(svgdoc.shape_tag(SvgGroupShape))
// ```
pub enum SvgShape
    // `<g>`: draws nothing itself, and exists to give its children a
    // shared transform, style and id.
    SvgGroupShape
    // `<rect>`, with SVG's corner radii.  `rx` and `ry` of zero are
    // square corners.
    SvgRectShape(x: Float, y: Float, width: Float, height: Float, rx: Float, ry: Float)
    // `<circle>`.
    SvgCircleShape(cx: Float, cy: Float, r: Float)
    // `<ellipse>`.
    SvgEllipseShape(cx: Float, cy: Float, rx: Float, ry: Float)
    // `<line>`.  Stroked only — a line has no interior, so its fill is
    // never drawn however the style is set.
    SvgLineShape(x1: Float, y1: Float, x2: Float, y2: Float)
    // `<polyline>`: connected segments, not closed.  Its FILL still
    // applies, which is SVG's most surprising rule and the reason
    // `svgstyle.stroked` exists.
    SvgPolylineShape(points: [GeomPointF])
    // `<polygon>`: the same, closed.
    SvgPolygonShape(points: [GeomPointF])
    // `<path>`, as a typed command list.
    SvgPathShape(path: SvgPath)
    // `<text>`: one run, at one anchor point.  No `tspan`, no
    // `textPath`, no wrapping — a document that needs a second line
    // uses a second node, which is what a plot does anyway.
    SvgTextShape(text: Str, x: Float, y: Float)

// One element of a document.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.child_count(svgdoc.group([]))}")
// ```
pub struct SvgNode
    // What it draws.
    shape: SvgShape
    // How it looks.  ABSOLUTE, not inherited: see `svgstyle`'s header.
    style: SvgStyle
    // The element's own transform, applied to it and to its children.
    // `svgdoc.no_transform()` when there is none, so that every node
    // reads one shape rather than an optional.
    transform: SvgTransform
    // The `id` attribute, or `""`.  Kept because a `url(#id)` paint
    // somewhere else in the document may name it, and because a caller
    // that built the tree wants its own handles back.
    id: Str
    // The children.  Non-empty only on a `SvgGroupShape` — every other
    // shape is a leaf, and the writer ignores children on one.
    children: [SvgNode]

// A whole document.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.child_count_of(svgdoc.document(640.0, 480.0, []))}")
// ```
pub struct SvgDocument
    // The viewport's width, with its unit.
    width: SvgLength
    // The viewport's height.
    height: SvgLength
    // The user coordinate system the contents are drawn in.
    view_box: SvgViewBox
    // The top-level elements.
    children: [SvgNode]

// A document `width` by `height` user units, with a `viewBox` matching.
//
// The constructor for the ordinary case — a drawing whose user units
// ARE its pixels — so a caller who does not care about resolution
// independence never meets a viewBox.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.document(640.0, 480.0, []).view_box.width}")
// ```
pub fn document(width: Float, height: Float, children: [SvgNode]) -> SvgDocument
    document_with(svgstyle.user(width), svgstyle.user(height), view_box(0.0, 0.0, width, height),
                  children)

// A document with its viewport and its user coordinate system named
// separately.
//
// ```novo
// use svgdoc
// use svgstyle
//
// fn main() [io]
//     let d = svgdoc.document_with(svgstyle.px(640.0), svgstyle.px(480.0),
//                                  svgdoc.view_box(0.0, 0.0, 1.0, 1.0), [])
//     println("${d.view_box.width}")
// ```
pub fn document_with(width: SvgLength, height: SvgLength, view_box: SvgViewBox,
                     children: [SvgNode]) -> SvgDocument
    SvgDocument { width: width, height: height, view_box: view_box, children: children }

// A view box from four numbers.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.view_box(0.0, 0.0, 640.0, 480.0).height}")
// ```
pub fn view_box(x: Float, y: Float, width: Float, height: Float) -> SvgViewBox
    SvgViewBox { x: x, y: y, width: width, height: height }

// A view box as the rectangle it is.
//
// ```novo
// use svgdoc
// use geomrect
//
// fn main() [io]
//     println("${geomrect.width(svgdoc.view_box_rect(svgdoc.view_box(0.0, 0.0, 4.0, 3.0)))}")
// ```
pub fn view_box_rect(v: SvgViewBox) -> GeomRectF
    geomrect.of_xywh(v.x, v.y, v.width, v.height)

// A rectangle as a view box.
//
// ```novo
// use svgdoc
// use geomrect
//
// fn main() [io]
//     println("${svgdoc.view_box_of(geomrect.of_xywh(0.0, 0.0, 4.0, 3.0)).width}")
// ```
pub fn view_box_of(r: GeomRectF) -> SvgViewBox
    view_box(r.min.x, r.min.y, geomrect.width(r), geomrect.height(r))

// The transform that changes nothing.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.no_transform().a}")
// ```
pub fn no_transform() -> SvgTransform
    of_xform(geomxform.identity())

// A document transform as geometry-nv's, so the algebra applies.
//
// ```novo
// use svgdoc
// use geomxform
//
// fn main() [io]
//     println("${geomxform.determinant(svgdoc.to_xform(svgdoc.no_transform()))}")
// ```
pub fn to_xform(t: SvgTransform) -> GeomXform
    geomxform.of_matrix(t.a, t.b, t.c, t.d, t.e, t.f)

// A `GeomXform` as a document transform.
//
// ```novo
// use svgdoc
// use geomxform
//
// fn main() [io]
//     println("${svgdoc.of_xform(geomxform.scaling(2.0, 2.0)).a}")
// ```
pub fn of_xform(x: GeomXform) -> SvgTransform
    SvgTransform { a: x.a, b: x.b, c: x.c, d: x.d, e: x.e, f: x.f }

// A group of children, with the default style and no transform.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.child_count(svgdoc.group([]))}")
// ```
pub fn group(children: [SvgNode]) -> SvgNode
    node(SvgGroupShape, svgstyle.plain(), children)

// A rectangle node.
//
// ```novo
// use svgdoc
// use svgstyle
// use geomrect
//
// fn main() [io]
//     let n = svgdoc.rect(geomrect.of_xywh(0.0, 0.0, 10.0, 10.0), svgstyle.plain())
//     println(svgdoc.shape_tag(n.shape))
// ```
pub fn rect(r: GeomRectF, style: SvgStyle) -> SvgNode
    node(SvgRectShape(r.min.x, r.min.y, geomrect.width(r), geomrect.height(r), 0.0, 0.0), style,
         [])

// A rectangle node with rounded corners.
//
// ```novo
// use svgdoc
// use svgstyle
// use geomrect
//
// fn main() [io]
//     let n = svgdoc.rounded_rect(geomrect.of_xywh(0.0, 0.0, 10.0, 10.0), 2.0, 2.0,
//                                 svgstyle.plain())
//     println(svgdoc.shape_tag(n.shape))
// ```
pub fn rounded_rect(r: GeomRectF, rx: Float, ry: Float, style: SvgStyle) -> SvgNode
    node(SvgRectShape(r.min.x, r.min.y, geomrect.width(r), geomrect.height(r), rx, ry), style,
         [])

// A circle node.
//
// ```novo
// use svgdoc
// use svgstyle
// use geompoint
//
// fn main() [io]
//     let n = svgdoc.circle(geompoint.origin(), 5.0, svgstyle.plain())
//     println(svgdoc.shape_tag(n.shape))
// ```
pub fn circle(center: GeomPointF, r: Float, style: SvgStyle) -> SvgNode
    node(SvgCircleShape(center.x, center.y, r), style, [])

// An ellipse node.
//
// ```novo
// use svgdoc
// use svgstyle
// use geompoint
//
// fn main() [io]
//     let n = svgdoc.ellipse(geompoint.origin(), 5.0, 3.0, svgstyle.plain())
//     println(svgdoc.shape_tag(n.shape))
// ```
pub fn ellipse(center: GeomPointF, rx: Float, ry: Float, style: SvgStyle) -> SvgNode
    node(SvgEllipseShape(center.x, center.y, rx, ry), style, [])

// A line node.
//
// ```novo
// use svgdoc
// use svgstyle
// use geompoint
//
// fn main() [io]
//     let n = svgdoc.line(geompoint.origin(), geompoint.ptf(10.0, 0.0), svgstyle.plain())
//     println(svgdoc.shape_tag(n.shape))
// ```
pub fn line(from: GeomPointF, to: GeomPointF, style: SvgStyle) -> SvgNode
    node(SvgLineShape(from.x, from.y, to.x, to.y), style, [])

// A polyline node: connected segments, not closed.
//
// ```novo
// use svgdoc
// use svgstyle
// use geompoint
//
// fn main() [io]
//     let ps = [geompoint.origin(), geompoint.ptf(10.0, 0.0)]
//     println(svgdoc.shape_tag(svgdoc.polyline(ps, svgstyle.plain()).shape))
// ```
pub fn polyline(points: [GeomPointF], style: SvgStyle) -> SvgNode
    node(SvgPolylineShape(points), style, [])

// A polygon node: the same, closed.
//
// ```novo
// use svgdoc
// use svgstyle
// use geompoint
//
// fn main() [io]
//     let ps = [geompoint.origin(), geompoint.ptf(10.0, 0.0), geompoint.ptf(0.0, 10.0)]
//     println(svgdoc.shape_tag(svgdoc.polygon(ps, svgstyle.plain()).shape))
// ```
pub fn polygon(points: [GeomPointF], style: SvgStyle) -> SvgNode
    node(SvgPolygonShape(points), style, [])

// A path node.
//
// ```novo
// use svgdoc
// use svgstyle
// use svgpath
//
// fn main() [io]
//     println(svgdoc.shape_tag(svgdoc.path(svgpath.empty(), svgstyle.plain()).shape))
// ```
pub fn path(p: SvgPath, style: SvgStyle) -> SvgNode
    node(SvgPathShape(p), style, [])

// A text node: one run, at one anchor point.
//
// ```novo
// use svgdoc
// use svgstyle
// use geompoint
//
// fn main() [io]
//     let n = svgdoc.text("hello", geompoint.origin(), svgstyle.plain())
//     println(svgdoc.shape_tag(n.shape))
// ```
pub fn text(content: Str, at: GeomPointF, style: SvgStyle) -> SvgNode
    node(SvgTextShape(content, at.x, at.y), style, [])

// The same node with a transform on it.
//
// ```novo
// use svgdoc
// use geomxform
//
// fn main() [io]
//     let n = svgdoc.with_transform(svgdoc.group([]), geomxform.translation(5.0, 0.0))
//     println("${n.transform.e}")
// ```
pub fn with_transform(n: SvgNode, t: GeomXform) -> SvgNode
    SvgNode { shape: n.shape, style: n.style, transform: of_xform(t), id: n.id,
              children: n.children }

// The same node with an id.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println(svgdoc.with_id(svgdoc.group([]), "axis").id)
// ```
pub fn with_id(n: SvgNode, id: Str) -> SvgNode
    SvgNode { shape: n.shape, style: n.style, transform: n.transform, id: id,
              children: n.children }

// The same node with a different style.
//
// ```novo
// use svgdoc
// use svgstyle
//
// fn main() [io]
//     let n = svgdoc.with_style(svgdoc.group([]), svgstyle.plain())
//     println("${n.style.opacity}")
// ```
pub fn with_style(n: SvgNode, style: SvgStyle) -> SvgNode
    SvgNode { shape: n.shape, style: style, transform: n.transform, id: n.id,
              children: n.children }

// The same node with one more child on the end.
//
// A child on a leaf shape is kept and never written, because silently
// dropping it would make `add_child` a function that sometimes does
// nothing.  `is_leaf` is the question to ask.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.child_count(svgdoc.add_child(svgdoc.group([]), svgdoc.group([])))}")
// ```
pub fn add_child(parent: SvgNode, child: SvgNode) -> SvgNode
    var kids = list.clone(parent.children)
    list.push(kids, child)
    SvgNode { shape: parent.shape, style: parent.style, transform: parent.transform,
              id: parent.id, children: kids }

// The same document with one more top-level element.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     let d = svgdoc.add(svgdoc.document(10.0, 10.0, []), svgdoc.group([]))
//     println("${svgdoc.child_count_of(d)}")
// ```
pub fn add(doc: SvgDocument, child: SvgNode) -> SvgDocument
    var kids = list.clone(doc.children)
    list.push(kids, child)
    SvgDocument { width: doc.width, height: doc.height, view_box: doc.view_box, children: kids }

// How many children a node has.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.child_count(svgdoc.group([]))}")
// ```
pub fn child_count(n: SvgNode) -> Int
    list.len(n.children)

// How many top-level elements a document has.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.child_count_of(svgdoc.document(10.0, 10.0, []))}")
// ```
pub fn child_count_of(doc: SvgDocument) -> Int
    list.len(doc.children)

// How many nodes the whole subtree holds, this one included.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.node_count(svgdoc.group([]))}")
// ```
pub fn node_count(n: SvgNode) -> Int
    var total = 1
    for k in n.children
        total = total + node_count(k)
    total

// Whether the shape is one that can have children — which is only the
// group.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.is_leaf(svgdoc.group([]))}")
// ```
pub fn is_leaf(n: SvgNode) -> Bool
    match n.shape
        SvgGroupShape => false
        _             => true

// The element name a shape is written as: `"g"`, `"rect"`, `"path"`.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println(svgdoc.shape_tag(SvgGroupShape))
// ```
pub fn shape_tag(s: SvgShape) -> Str
    match s
        SvgGroupShape                  => "g"
        SvgRectShape(_, _, _, _, _, _) => "rect"
        SvgCircleShape(_, _, _)        => "circle"
        SvgEllipseShape(_, _, _, _)    => "ellipse"
        SvgLineShape(_, _, _, _)       => "line"
        SvgPolylineShape(_)            => "polyline"
        SvgPolygonShape(_)             => "polygon"
        SvgPathShape(_)                => "path"
        SvgTextShape(_, _, _)          => "text"

// The node whose id is this, anywhere in the subtree, or the subtree's
// own root when there is none.
//
// Not `?SvgNode`: a lookup that answers a node is what a caller wants,
// and `has_id` is the question that separates "found it" from "did
// not".  Two calls where a `match` would have been one, in exchange for
// a return type a caller cannot forget to unwrap.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println(svgdoc.find_by_id(svgdoc.group([]), "axis").id)
// ```
pub fn find_by_id(n: SvgNode, id: Str) -> SvgNode
    for m in walk(n)
        if m.id == id
            return m
    n

// Whether any node in the subtree carries this id.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.has_id(svgdoc.group([]), "axis")}")
// ```
pub fn has_id(n: SvgNode, id: Str) -> Bool
    list.any(walk(n), m => m.id == id)

// Every node of the subtree, parents before children, as one list.
//
// The walk a renderer does, written once.  The transform on each node
// is its OWN, not the accumulated one — `flatten_transforms` is what
// accumulates.
//
// ```novo
// use svgdoc
// use std.list
//
// fn main() [io]
//     println("${list.len(svgdoc.walk(svgdoc.group([])))}")
// ```
pub fn walk(n: SvgNode) -> [SvgNode]
    var out: [SvgNode] = []
    walk_into(out, n)
    out

// The same subtree with every transform composed down from the root and
// every group's transform cleared.
//
// What a renderer with no transform stack wants, and what makes
// `bounds` a straight walk.  The shapes themselves are NOT transformed
// — their coordinates stay as written and the node's transform carries
// the change, so the tree still round-trips.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.node_count(svgdoc.flatten_transforms(svgdoc.group([])))}")
// ```
pub fn flatten_transforms(n: SvgNode) -> SvgNode
    flatten_under(n, geomxform.identity())

// The smallest rectangle containing everything the subtree draws, in
// the coordinate system the subtree's parent uses.
//
// TEXT IS ESTIMATED, not measured — see `text_advance_estimate` — so a
// subtree containing text has approximate bounds and this is the one
// place this package's answer is not exact.  A caller who needs the
// real box measures the text with a font package and unions it in.
//
// ```novo
// use svgdoc
// use geomrect
//
// fn main() [io]
//     println("${geomrect.is_empty(svgdoc.bounds(svgdoc.group([])))}")
// ```
pub fn bounds(n: SvgNode) -> GeomRectF
    bounds_under(n, geomxform.identity())

// The smallest rectangle containing everything a document draws.
//
// ```novo
// use svgdoc
// use geomrect
//
// fn main() [io]
//     println("${geomrect.is_empty(svgdoc.document_bounds(svgdoc.document(10.0, 10.0, [])))}")
// ```
pub fn document_bounds(doc: SvgDocument) -> GeomRectF
    var box = geomrect.empty()
    for k in doc.children
        box = union_of(box, bounds(k))
    box

// How wide a text run is likely to be, from its length and its font
// size alone.
//
// AN ESTIMATE, AND IT SAYS SO IN ITS NAME.  Measuring text needs glyph
// advances, which need a font file, which needs a filesystem — and this
// package is `core`.  The number here is the length times the size
// times a constant close to the average advance of a proportional Latin
// face, which is right to within a fifth for ordinary text and wrong
// for anything else.
//
// It exists because `bounds` has to return something for a text node,
// and a silent zero would make a plot's auto-sized viewBox clip its own
// axis labels.  A caller that needs the real width measures it and
// unions it in.
//
// ```novo
// use svgdoc
//
// fn main() [io]
//     println("${svgdoc.text_advance_estimate("hello", 16.0)}")
// ```
pub fn text_advance_estimate(content: Str, font_size: Float) -> Float
    code_points(content) as Float * font_size * advance_per_em()

// The whole subtree as one path, with every shape converted and every
// transform applied.
//
// For a consumer with one primitive: a rasteriser, a plotter, a CNC
// toolpath.  Text is DROPPED rather than converted, because turning a
// string into outlines needs the font file this package does not have —
// and dropping it visibly is better than emitting an empty path that
// looks like a bug in the caller.
//
// ```novo
// use svgdoc
// use svgpath
//
// fn main() [io]
//     println("${svgpath.command_count(svgdoc.to_path(svgdoc.group([])))}")
// ```
pub fn to_path(n: SvgNode) -> SvgPath
    var cs: [SvgPathCmd] = []
    path_into(cs, n, geomxform.identity())
    svgpath.of_commands(cs)

fn node(shape: SvgShape, style: SvgStyle, children: [SvgNode]) -> SvgNode
    SvgNode { shape: shape, style: style, transform: no_transform(), id: "", children: children }

// Appends the subtree to `out`, parents before children.
fn walk_into(var out: [SvgNode], n: SvgNode)
    list.push(out, n)
    for k in n.children
        walk_into(out, k)

// The subtree with `outer`, the transform its ancestors compose to,
// composed into every node.  A group keeps no transform of its own.
fn flatten_under(n: SvgNode, outer: GeomXform) -> SvgNode
    let total = geomxform.compose(to_xform(n.transform), outer)
    var kids: [SvgNode] = []
    for k in n.children
        list.push(kids, flatten_under(k, total))
    let own = if is_leaf(n)
        total
    else
        geomxform.identity()
    SvgNode { shape: n.shape, style: n.style, transform: of_xform(own), id: n.id, children: kids }

// The union of two boxes, where a box of zero width or height still
// holds the points on it.  `geomrect.union` treats such a box as
// empty, which would drop a horizontal line from a bounding box.
fn union_of(a: GeomRectF, b: GeomRectF) -> GeomRectF
    if b.min.x > b.max.x or b.min.y > b.max.y
        return a
    geomrect.extend(geomrect.extend(a, b.min), b.max)

// The subtree's box after its own transform and then `outer`.  Each
// leaf's outline is transformed before its box is taken, so a rotated
// curve gets a tight box rather than the box of a rotated box.
fn bounds_under(n: SvgNode, outer: GeomXform) -> GeomRectF
    let total = geomxform.compose(to_xform(n.transform), outer)
    match n.shape
        SvgGroupShape         =>
            var box = geomrect.empty()
            for k in n.children
                box = union_of(box, bounds_under(k, total))
            box
        SvgTextShape(s, x, y) =>
            svgpath.bounds(svgpath.transform(text_box(s, x, y, n.style), total))
        _                     => svgpath.bounds(svgpath.transform(outline(n.shape), total))

// The average advance of a proportional Latin face, as a fraction of
// the font size.
fn advance_per_em() -> Float
    0.55

// How many code points a string holds: its bytes, less the UTF-8
// continuation bytes.
fn code_points(s: Str) -> Int
    var n = 0
    for i in 0..str.len(s)
        let b = str.byte_at_or(s, i, 0)
        if b < 128 or b >= 192
            n = n + 1
    n

// The estimated box of a text run as a closed path.  The run is
// `text_advance_estimate` wide, placed by its anchor, and one font
// size tall with four fifths of it above the baseline.
fn text_box(s: Str, x: Float, y: Float, style: SvgStyle) -> SvgPath
    let w = text_advance_estimate(s, style.font.size)
    let left = match style.text_anchor
        SvgAnchorStart  => x
        SvgAnchorMiddle => x - w / 2.0
        SvgAnchorEnd    => x - w
    let top = y - 0.8 * style.font.size
    svgpath.of_rect(geomrect.of_xywh(left, top, w, style.font.size), 0.0, 0.0)

// A shape's outline as a path.  A group has none, and text has none
// that can be drawn without a font.
fn outline(s: SvgShape) -> SvgPath
    match s
        SvgRectShape(x, y, w, h, rx, ry) => svgpath.of_rect(geomrect.of_xywh(x, y, w, h), rx, ry)
        SvgCircleShape(cx, cy, r)        => svgpath.of_ellipse(geompoint.ptf(cx, cy), r, r)
        SvgEllipseShape(cx, cy, rx, ry)  => svgpath.of_ellipse(geompoint.ptf(cx, cy), rx, ry)
        SvgLineShape(x1, y1, x2, y2)     =>
            svgpath.line_to(svgpath.move_to(svgpath.empty(), x1, y1), x2, y2)
        SvgPolylineShape(ps)             => svgpath.of_points(ps, false)
        SvgPolygonShape(ps)              => svgpath.of_points(ps, true)
        SvgPathShape(p)                  => p
        SvgGroupShape                    => svgpath.empty()
        SvgTextShape(_, _, _)            => svgpath.empty()

// Appends the subtree's outlines, through its transforms, to `out`.
fn path_into(var out: [SvgPathCmd], n: SvgNode, outer: GeomXform)
    let total = geomxform.compose(to_xform(n.transform), outer)
    list.append(out, svgpath.commands_of(svgpath.transform(outline(n.shape), total)))
    if not is_leaf(n)
        for k in n.children
            path_into(out, k, total)
