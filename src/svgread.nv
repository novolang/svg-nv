// svgread.nv — text into a document, for the subset a program
// round-trips.
//
// WHAT THIS READER IS FOR.  Not "read any SVG" — that is a renderer's
// job and needs CSS, a font database and a paint-server resolver.  This
// reads the subset `svgwrite` writes plus the subset a drawing program
// exports, and it answers one question honestly: **what does this
// document draw, as shapes with absolute styles?**  usvg is the
// reference, and this is its contract at a smaller scale.
//
// THREE THINGS HAPPEN ON THE WAY IN, and they are the reason a parsed
// document is easier to use than the text it came from:
//
//   - **Inheritance is resolved.**  Every node comes out carrying the
//     style it actually renders with.  Nothing in the tree needs a walk
//     to the root to be understood.
//   - **Paths are normalised.**  Relative becomes absolute, `H`/`V`/
//     `S`/`T` become their long forms, and the current point is gone by
//     the time a caller sees anything.  See `svgpath`'s header.
//   - **Shapes stay shapes.**  A `<rect>` comes back as a
//     `SvgRectShape` and not as a path.  usvg converts everything to
//     paths because a renderer wants one primitive; this package keeps
//     the distinction because a ROUND TRIP is the point, and
//     `svgdoc.to_path` is there for a caller who wants usvg's answer.
//
// WHAT IS SKIPPED RATHER THAN REFUSED: every element and attribute this
// package does not model — gradients, patterns, filters, masks, clip
// paths, markers, `use`, `image`, CSS blocks, animation, metadata,
// namespaced attributes from an editor.  `parse_report` counts them and
// names the first few, so a caller can tell the difference between
// "read it all" and "read the half of it that was shapes".  A reader
// that refused a document with a `<style>` block in it would refuse
// most SVG files in the world.
//
// A `url(#id)` PAINT IS PRESERVED as `SvgPaintRef`, so a document that
// uses a gradient comes back with its reference intact even though the
// gradient itself was skipped.  Writing it out again produces a
// document that names a paint server that is no longer in it — which is
// the honest outcome, and `SvgReadReport.skipped_elements` is how a
// caller knows to expect it.
//
// NO EFFECTS.  The text is the caller's; this module reads it.

use svgdoc
use svgpath
use svgstyle

// What a parse left behind.
//
// ```novo
// use svgread
//
// fn main() [io]
//     match svgread.parse_report("<svg width=\"1\" height=\"1\"/>")
//         Ok(r)  => println("${r.skipped_elements}")
//         Err(_) => println("refused")
// ```
pub struct SvgReadReport
    // The document that was read.
    document: SvgDocument
    // How many elements were skipped because this package does not
    // model them.
    skipped_elements: Int
    // How many attributes were skipped on elements that WERE read.
    skipped_attributes: Int
    // The first few skipped element names, in document order, for a
    // message a caller can show.  Bounded — a document with ten
    // thousand skipped elements does not produce ten thousand strings.
    skipped_names: [Str]
    // Whether any `url(#id)` paint survived a paint server that did
    // not.  The one case where the document that comes back out is not
    // a valid rendering of the one that went in.
    has_dangling_paint: Bool

// A document from SVG text.
//
// ```novo
// use svgread
// use svgdoc
//
// fn main() [io]
//     match svgread.parse("<svg width=\"10\" height=\"10\"/>")
//         Ok(d)  => println("${svgdoc.child_count_of(d)}")
//         Err(_) => println("refused")
// ```
pub fn parse(text: Str) -> Result<SvgDocument, SvgFault>
    todo("svg-nv.svgread.parse")

// The same, with a count of what was skipped.
//
// The one to call when the caller has to tell a person whether the file
// came through whole.
//
// ```novo
// use svgread
//
// fn main() [io]
//     match svgread.parse_report("<svg width=\"10\" height=\"10\"/>")
//         Ok(r)  => println("${r.skipped_elements}")
//         Err(_) => println("refused")
// ```
pub fn parse_report(text: Str) -> Result<SvgReadReport, SvgFault>
    todo("svg-nv.svgread.parse_report")

// The same, with a nesting limit of the caller's choosing.
//
// `parse` uses a fixed limit; this is for a caller reading a document
// from somewhere it does not trust and wanting a tighter one.  A
// document deeper than the limit is `SvgTooDeep`, not a stack overflow:
// a `core` package has no allocator failure path to catch one with.
//
// ```novo
// use svgread
// use svgdoc
//
// fn main() [io]
//     match svgread.parse_within("<svg width=\"10\" height=\"10\"/>", 16)
//         Ok(d)  => println("${svgdoc.child_count_of(d)}")
//         Err(_) => println("refused")
// ```
pub fn parse_within(text: Str, max_depth: Int) -> Result<SvgDocument, SvgFault>
    todo("svg-nv.svgread.parse_within")

// A path from a `d` attribute's text.
//
// Public on its own because a `d` attribute is the single most useful
// thing to lift out of an SVG — a font's glyph outline, an icon set, a
// map's boundaries — and a caller doing that should not have to build a
// document around it.
//
// ```novo
// use svgread
// use svgpath
//
// fn main() [io]
//     match svgread.parse_path("M 0 0 L 10 0")
//         Ok(p)  => println("${svgpath.command_count(p)}")
//         Err(_) => println("refused")
// ```
pub fn parse_path(d: Str) -> Result<SvgPath, SvgFault>
    todo("svg-nv.svgread.parse_path")

// A transform from a `transform` attribute's text.
//
// SVG's six functions — `matrix`, `translate`, `scale`, `rotate`,
// `skewX`, `skewY` — composed left to right into one transform, which
// is what the attribute means.  Angles in the TEXT are degrees, SVG's
// unit; the `SvgTransform` that comes back is the composed matrix, so
// the question does not arise again.
//
// ```novo
// use svgread
//
// fn main() [io]
//     match svgread.parse_transform("translate(5 0)")
//         Ok(t)  => println("${t.e}")
//         Err(_) => println("refused")
// ```
pub fn parse_transform(s: Str) -> Result<SvgTransform, SvgFault>
    todo("svg-nv.svgread.parse_transform")

// A length from an attribute's text: a number and an optional unit.
//
// ```novo
// use svgread
//
// fn main() [io]
//     match svgread.parse_length("640px")
//         Ok(l)  => println("${l.value}")
//         Err(_) => println("refused")
// ```
pub fn parse_length(s: Str) -> Result<SvgLength, SvgFault>
    todo("svg-nv.svgread.parse_length")

// A view box from a `viewBox` attribute's text: four numbers.
//
// ```novo
// use svgread
//
// fn main() [io]
//     match svgread.parse_view_box("0 0 640 480")
//         Ok(v)  => println("${v.width}")
//         Err(_) => println("refused")
// ```
pub fn parse_view_box(s: Str) -> Result<SvgViewBox, SvgFault>
    todo("svg-nv.svgread.parse_view_box")

// A paint from a `fill` or `stroke` attribute's text.
//
// `"none"`, a colour in any of color-nv's spellings, or `url(#id)`.
// Every colour form goes through `colortext.parse`, so this package and
// every other consumer of color-nv agree on what `rebeccapurple` means.
//
// ```novo
// use svgread
// use svgstyle
//
// fn main() [io]
//     match svgread.parse_paint("#ff0000")
//         Ok(p)  => println(svgstyle.paint_to_string(p))
//         Err(_) => println("refused")
// ```
pub fn parse_paint(s: Str) -> Result<SvgPaint, SvgFault>
    todo("svg-nv.svgread.parse_paint")

// A dash pattern from a `stroke-dasharray` attribute's text.
//
// `"none"` gives an empty list.  A pattern with an odd number of
// entries is returned AS WRITTEN rather than doubled — the doubling is
// SVG's rendering rule and belongs to whatever renders it, not to the
// value this reader produces.
//
// ```novo
// use svgread
// use std.list
//
// fn main() [io]
//     match svgread.parse_dash_array("4 2")
//         Ok(d)  => println("${list.len(d)}")
//         Err(_) => println("refused")
// ```
pub fn parse_dash_array(s: Str) -> Result<[Float], SvgFault>
    todo("svg-nv.svgread.parse_dash_array")

// Whether the text looks like an SVG document at all: an `<svg>`
// element somewhere near the start.
//
// A cheap test for a caller sniffing a file it has not parsed yet, and
// the one `image-io-nv` would use to pick a decoder.
//
// ```novo
// use svgread
//
// fn main() [io]
//     println("${svgread.looks_like_svg("<svg/>")}")
// ```
pub fn looks_like_svg(text: Str) -> Bool
    todo("svg-nv.svgread.looks_like_svg")
